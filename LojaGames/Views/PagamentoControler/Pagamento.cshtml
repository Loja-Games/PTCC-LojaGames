<link href="~/css/pagamento.css" rel="stylesheet" />




<div class="borda fundocontainerpagamento">
	<form class="bg-white formulario" action="/" method="post">
		<div class="row">
			<label>Endereço de Entrega:</label>
		</div>
		<div class="row">
			<div class="divendereco m-1">endereco asddasdsasda asdasdasdads asdadssaasdasd dasddaasdasd</div>
			<div class="divendereco m-1">endereco asddasdsasda asdasdasdads asdadssaasdasd dasddaasdasd</div>
			<div class="divendereco m-1">endereco asddasdsasda asdasdasdads asdadssaasdasd dasddaasdasd</div>
		</div>
		<hr>
		<div class="row">
			<label>Pagamento:</label>
		</div>
		<div class="row">
			<div class="col">
				<label style="padding-left:25px;" class="w-100 pb-1 fontpagina">METODOS DE PAGAMENTO:</label>
				<div class="listadebotoes">
					<button type="button" class="fontbold fontpagina w-100 botaoselecionarpag btboleto p-1 m-1"><img class="iconespag" src="~/assets/image/icones/iconeboleto.png" />Boleto</button>
					<button type="button" class="fontbold fontpagina w-100 botaoselecionarpag btpix p-1 m-1"><img class="iconespag" src="~/assets/image/icones/iconepix.svg" />PIX</button>
					<button type="button" class="fontbold fontpagina w-100 botaoselecionarpag btcartaocred p-1 m-1"><img class="iconespag" src="~/assets/image/icones/iconecartao.png" />Cartão de Credito</button>
					<button type="button" class="fontbold fontpagina w-100 botaoselecionarpag background-color p-1 m-1"><img class="iconespag" src="~/assets/image/icones/iconecartao.png" />Cartão de Debito</button>
				</div>
			</div>
			<div class="col">
				<label>Dados de Pagamento:</label>
				<div class="backcartao">
					
					<div class="row">
						<div class="listaopc w-100">
							<label>Numero do cartão:</label>
							<input name="numerocartao" id="numerocartao" maxlength="16" minlength="16" class="w-100" type="text">
						</div>
					</div>
					<div class="row">
						<div class="listaopc w-50">
							<label>Data do vencimento:</label>
							<input name="datacartao" type="month">
						</div>
						<div class="listaopc w-50">
							<label>CVC</label>
							<input name="cvccartao" maxlength="3" minlength="3" type="text">
						</div>

					</div>
					<div class="row">
						<div class="listaopc">
							<label>Nome do cartão:</label>
							<input type="text" name="nomecartao">
							<img id="bande" class="bandeira" src="" />
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="w-100 d-flex justify-content-center p-3">
			<button class="fontbold fontpagina text-black btn btn-success botaodesucesso">FINALIZAR PEDIDO</button>
		</div>
		
	
	
	</form>
	
	
</div>
<script src="~/js/pagamento.js"></script>